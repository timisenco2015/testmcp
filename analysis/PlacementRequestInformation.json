  "workflows": [
    {
      "name": "Placement Request Lifecycle",
      "steps": [
        "Request creation by PA",
        "Assignment of destination, site, service",
        "Coordinator filtering (group, non-group, program, course)",
        "Validation: allowed sites/services/destinations",
        "Assignment of student and supervisor",
        "Consent and privacy checks",
        "Status transitions: New → Sent → Redir → AccA/AccD/Conf/DecA/DecD/Canc",
        "Alerts: Urgent, Comments, Conditions",
        "Reminder setup and sending",
        "Amendments: shift, hours, days",
        "History tracking: changes, merges, status updates",
        "Release logic (NIS/IRP and regular)",
        "Exceptions: cancellations, declines, unassigned students/instructors",
        "Group-specific logic (site instructor, group size, block2 handling)",
        "End of request (confirmed, declined, cancelled, completed)",
        "Document upload and attachment"
      ]
    }
  ],
  "business_rules": [
    "Skip parent CFO PRs for display to users except in CFO Pending stats",
    "Apply PC (placing coordinator) filter if not ALL",
    "Skip entries using 'SharedAlt' service",
    "Do not display student data when consent is expired (privacy)",
    "Student gender is displayed only if program discloses and destination requires",
    "AccA/Conf Group PRs must have site instructor if required",
    "Alerts, comments, and condition changes trigger history and audit events",
    "Group/Non-group logic affects assignment, status, and supervisor handling",
    "Block2 handling: use block 2 dates if present and applicable",
    "Placement request must comply with allowed agencies, sites, services, destinations"
  ],
  "validations": [
    "Validate allowed sites, services, destinations per user role and session",
    "Student consent validation for privacy",
    "Group size validation",
    "Supervisor assignment validation",
    "Invoice status validation",
    "Date validation for upcoming/overdue requests",
    "Condition and alert presence triggers additional logic",
    "Gender validation (missing, required, disclosed)",
    "Document existence checks for PR and student"
  ],
  "calculations": [
    "ShiftLength = ShiftCode, StartTime, EndTime",
    "StatusCodeFormatted = Display logic based on role/status",
    "EndDateForDisplay = Block2 or regular end date",
    "DaysFormatted = Calculated from day-of-week flags",
    "ReportTag formatting logic",
    "Calendar Grid icon and scheduling"
  ],
  "conditions": [
    "ConditionCodeID triggers alerts and workflow",
    "Urgent alerts for upcoming placements without students/instructors",
    "ConflictAlert and ConflictResolved affect display and workflow",
    "AmendmentExemptionsExist disables or enables amendment logic"
  ],
  "system_behavior": [
    "Grey-out rows for NIS/IRP mode disabled PRs",
    "Audit history for each action (comments, status, merges, assignment)",
    "Remove entries based on ignored PRs/userIgnoredPRs",
    "Document upload status alters UI",
    "Show/hide supervisor dropdown per status, type, group logic",
    "Display logic varies with role (PC, RC, DC, NIS/IRP)",
    "Double-count prevention in group/add-destination logic"
  ],
  "dependencies": [
    "PlacementRequestTypes code table",
    "AllowedList session data",
    "Student object for consent, privacy, gender, assignment",
    "StatusCodeFormatter for workflow state transitions",
    "Database utility functions for date checks, formatting"
  ],
  "exceptions": [
    "Cancelled by PA, RA, or system",
    "Declined by PA, RA, or system",
    "Unassigned due to decline/cancel",
    "No student assigned for upcoming requests",
    "Supervisor missing for group and non-group PRs",
    "Amendment exemption disables further amendments"
  ],
