{
    "filename": "Worksheet",
    "found": true,
    "summary": "The Worksheet module encompasses functionalities related to managing educational timetables and worksheets in an institutional setting.",
    "purpose": "To facilitate the organization and scheduling of courses, instructors, and campuses using worksheets.",
    "entities": [],
    "fields": [
      "Department",
      "Program",
      "Cohort",
      "Term",
      "Course",
      "Site",
      "Service",
      "Instructor",
      "Start Date",
      "End Date"
    ],
    "actors": [
      "UserSession",
      "Instructor"
    ],
    "workflows": [
      {
        "name": "Initialize Worksheet Filters",
        "steps": [
          "Retrieve session variables like CohortID, TermID, CourseID.",
          "Setup dropdowns for department, program, cohort, term, and course.",
          "Set up filtering options and initialize dropdowns for site, service, instructor, date, campus, section."
        ]
      },
      {
        "name": "Update Worksheet",
        "steps": [
          "Handle dropdown changes in department, program, cohort, term, and course.",
          "Refresh data by applying new filter values and invoking search functions."
        ]
      }
    ],
    "business_rules": [
      "If no entries exist yet, users can copy data from a previous term.",
      "Filters should be set up correctly to ensure accurate data retrieval."
    ],
    "validations": [
      {
        "function": "checkTimePeriod",
        "description": "Ensures the start and end times form a valid time period."
      },
      {
        "function": "checkValidBlock2Dates",
        "description": "Validates that Block2 dates are correctly formatted and ordered."
      }
    ],
    "calculations": [
      {
        "function": "ParseDate",
        "description": "Parses and returns the date from a string."
      },
      {
        "function": "DaysBetween",
        "description": "Calculates the number of days between two dates."
      }
    ],
    "conditions": [
      {
        "expression": "Session[\"AgencySiteID\"] != null",
        "description": "Checks if the AgencySiteID is set in the session."
      }
    ],
    "system_behavior": [
      "Dropdowns dynamically populate based on user session data.",
      "The UI updates as per dropdown selections and filter applications."
    ],
    "dependencies": [
      "HSPnet.UI",
      "HSPnet.Framework",
      "HSPnet.App_GlobalResources"
    ],
    "exceptions": [
      {
        "type": "Web.UI.WebControls.Error",
        "description": "Triggers when validation fails for date and time inputs."
      }
    ],
