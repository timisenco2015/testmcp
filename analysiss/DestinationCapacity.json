    "workflows": [
        {
            "name": "DestinationCapacity Copy",
            "steps": [
                "Check if SourceDestinationCodeID is valid.",
                "Get database connection from session.",
                "Set procedure name to 'DestinationCapacityCopy'.",
                "Add parameters and execute the procedure.",
                "Log success or error message."
            ]
        },
        {
            "name": "Update DestinationCapacity",
            "steps": [
                "Check if AcceptsGroups is true and update fields accordingly.",
                "Update MaxShiftsPerWeek fields based on shift types.",
                "Set database procedure to 'DestinationCapacityUpdateGroup' or 'DestinationCapacityUpdateIndividual'.",
                "Execute the procedure with parameters."
            ]
        }
    ],
    "business_rules": [
        "If Shifts8Days or Shifts8Eves, calculate count8Hour.",
        "If Shifts12Days, calculate count12Hour.",
        "If destination accepts groups, set specific comment and reason codes."
    ],
    "validations": [
        "Check if SubDisciplineID is -1 for grouping code.",
        "Verify entries using EqualExceptForSubDiscipline method."
    ],
    "calculations": [
        "Calculate MaxShiftsPerWeek based on weekdays selected.",
        "Format hours per week for different shift types."
    ],
    "conditions": [
        "If Shifts8Days, format with 'Days - 8'.",
        "If entry.GroupFlag is true, use MaxShiftsPerWeek; otherwise, use HoursPerWeek."
    ],
    "system_behavior": [
        "Copy entries from one destination to another using DestinationCapacityCopy.",
        "Update group or individual records based on provided parameters."
    ],
    "dependencies": [
        "Database connection via HSPnetSession.",
        "Resource strings for formatting output."
    ],
    "exceptions": [
        "No entries copied if SourceDestinationCodeID is invalid.",
